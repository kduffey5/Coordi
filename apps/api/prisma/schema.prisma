// Prisma schema - this is a symlink or copy of the root schema
// In production, we'll use the root prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id              String    @id @default(uuid())
  name            String
  twilioNumber    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  users           User[]
  agentProfile    AgentProfile?
  businessProfile BusinessProfile?
  conversations   Conversation[]
  leads           Lead[]
  integrations    Integration?
}

model User {
  id             String       @id @default(uuid())
  email          String       @unique
  passwordHash   String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  role           String       @default("owner")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

model AgentProfile {
  id                      String       @id @default(uuid())
  organization            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId          String       @unique
  voice                   String       @default("alloy")
  tone                    Int          @default(50)
  pace                    Int          @default(50)
  confidence              Int          @default(50)
  energy                  Int          @default(50)
  fillerLevel             Int          @default(50)
  interruptionSensitivity Int          @default(50)
  empathyLevel            Int          @default(50)
  formality               Int          @default(50)
  welcomePrompt           String       @default("")
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  @@index([organizationId])
}

model BusinessProfile {
  id             String       @id @default(uuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String       @unique
  companyName    String
  description    String?
  serviceAreas   String?
  servicesOffered String?
  pricingInfo    String?
  policies       String?
  faq            String?
  // New structured fields
  companyInfo    Json?        // Business name, greeting format, phone, service hours, after-hours behavior
  serviceAreaConfig Json?     // List of zip codes/cities, out-of-area response
  servicesConfig Json?        // Array of services with details (name, description, quoting type, questions, add-ons)
  pricingPhilosophy String?   // "soft_ranges", "quote_with_photos", "never_discuss_price"
  policiesConfig Json?        // Cancellation, rain, payment, pet/gate, satisfaction guarantee
  localKnowledge Json?        // Array of knowledge entries with text and location tags
  voiceBehavior  Json?        // Tone, empathy, preferred words, team name reference
  lawnExpertMode Boolean      @default(false) // Enable lawn care expert mode
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

model Conversation {
  id            String       @id @default(uuid())
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  fromNumber    String
  toNumber      String
  twilioCallSid String?      @unique
  startTime     DateTime     @default(now())
  endTime       DateTime?
  durationSeconds Int?
  summary       String?
  transcript    String?
  recordingUrl  String?
  isLead        Boolean      @default(false)
  status        String       @default("new") // new, booked, followed_up, escalated, missed
  tags          String[]     @default([]) // e.g. ['sprinkler repair', 'overgrown']
  metadata      Json?        // Additional flexible data
  lead          Lead?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([organizationId])
  @@index([startTime])
  @@index([isLead])
  @@index([status])
}

model Lead {
  id              String       @id @default(uuid())
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId  String
  conversation    Conversation?        @relation(fields: [conversationId], references: [id])
  conversationId  String?      @unique
  name            String?
  phone           String?
  email           String?
  address         String?
  serviceRequested String?
  scheduledDate   DateTime?
  status          String       @default("new")
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([organizationId])
  @@index([status])
  @@index([conversationId])
}

model Integration {
  id              String       @id @default(uuid())
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId  String       @unique
  calendlyLink    String?
  zapierHookUrl   String?
  emergencyNumber String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([organizationId])
}


